import "../lib/lib.wilios"

let rytm7 = func() {
    <A3, C4> 4/4
    <D3, C3> 4/4
    <F3, A3> 4/4
    <G3, D4> 4/4
}

let bb = func() {
    rest 1/4
    <A2> 3/4

    rest 1/4
    <D2> 3/4
    
    rest 1/4
    <F2> 3/4
    
    rest 1/4
    <G2> 3/4
}


track 1
tempo 116
volume 50
strings()

rest 4/4

let i = 0
loop (i < 2) {
    i = i + 1
    rytm7()
}


track 2
tempo 232
epiano()

let verse = func() {
    rest 1/4
    <C1> 1/8
    <C1> 1/8
    <B1> 1/8
    <A1> 1/8
    <E1> 1/8
    <E1> 1/8

    <F1> 1/4
    <B1> 1/2.

    rest 1/4
    <F1> 1/4
    <A1> 1/4
    <C1> 1/8
    <G1> 1/8

    <C1> 1/4
    <B1> 1/2.
}


let j = 0

loop (j < 4) {
    j = j + 1

    verse()
} 


track 3
tempo 116
volume 100
bass()

rest 4/4 

let k = 0
loop (k < 2) {
    k = k + 1
    bb()
}

track 4
tempo 116
kick()
let m = 0
loop (m < 8) {
    m = m + 1
    rest 1/4
    <B1> 1/4
