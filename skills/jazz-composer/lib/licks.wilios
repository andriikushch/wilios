// ============================================================
//  licks.wilios — melodic bebop idioms (jazz-composer skill)
//
//  import "<rel>/skills/jazz-composer/lib/licks.wilios"
//
//  Every helper is CALLED IN STATEMENT POSITION (on its own line) and
//  emits notes onto the current track. They take a *root pitch* and place
//  themselves with `transpose`, so one lick plays in any key:
//
//      arp7(C4)                 // C E G Bb  as four 8ths
//      ii_v_i_maj(Bb4)          // a 2-bar ii-V-I bebop line in Bb
//
//  `key` / `root` is the tonic (or chord root) pitch. Nothing is returned;
//  a `let` bound inside a body is discarded when the call returns.
// ============================================================

// --- enclose(t): the two-8th enclosure PICKUP into target `t` — half step
//     above, then half step below (= one beat). It does NOT play `t`: play
//     the target yourself on the next beat, so it lands on the beat, which
//     is the whole point of an enclosure.
let enclose = func(t) {
    <transpose(t, 1)> 1/8
    <transpose(t, -1)> 1/8
}

// --- approach_below(t) / approach_above(t): a single chromatic approach
//     note then the target, two 8th notes (= one beat). (A bare variable
//     is not a valid duration in wilios, so these are fixed at 8ths;
//     write the rhythm out by hand when you need something else.)
let approach_below = func(t) {
    <transpose(t, -1)> 1/8
    <t> 1/8
}
let approach_above = func(t) {
    <transpose(t, 1)> 1/8
    <t> 1/8
}

// --- arp7 / arp_maj7 / arp_min7 (root): arpeggio through the 7th,
//     ascending, four 8th notes (= two beats).
//       arp7      root  3   5   b7    (dominant 7)
//       arp_maj7  root  3   5   7     (major 7)
//       arp_min7  root  b3  5   b7    (minor 7)
let arp7 = func(root) {
    <root> 1/8  <transpose(root, 4)> 1/8  <transpose(root, 7)> 1/8  <transpose(root, 10)> 1/8
}
let arp_maj7 = func(root) {
    <root> 1/8  <transpose(root, 4)> 1/8  <transpose(root, 7)> 1/8  <transpose(root, 11)> 1/8
}
let arp_min7 = func(root) {
    <root> 1/8  <transpose(root, 3)> 1/8  <transpose(root, 7)> 1/8  <transpose(root, 10)> 1/8
}

// --- ii_v_i_maj(key): a 2-bar bebop line over  | iim7  V7 |  Imaj7 |
//     1-b3 of ii, enclose the 3rd of V7 so it lands on beat 3, run down
//     V7 (3 1 b7 5), resolve by step to the 3rd of I. `key` = the I root.
//     In C: D F | C A# | B G | F D || E D C - -
let ii_v_i_maj = func(key) {
    // bar 1 : iim7 for 2 beats, then V7 for 2 beats
    <transpose(key, 2)> 1/8  <transpose(key, 5)> 1/8     // 1 b3 of ii
    enclose(transpose(key, 11))                          // pickup into 3rd of V7
    <transpose(key, 11)> 1/8 <transpose(key, 7)> 1/8     // 3 1 of V7 (beat 3)
    <transpose(key, 5)> 1/8  <transpose(key, 2)> 1/8     // b7 5 of V7
    // bar 2 : Imaj7 — land on the 3rd, fall to the root, breathe
    <transpose(key, 4)> 1/8  <transpose(key, 2)> 1/8  <key> 1/4
    rest 1/2
}

// --- turnaround_maj(key): a 2-bar line over  | I  VI7 | ii  V7 |
//     one chord every 2 beats; the 3rds of VI7 and V7 land on beat 3.
//     In C: C E | D C | C# E | G Bb || A F | C A# | B G | F D
let turnaround_maj = func(key) {
    <key> 1/8 <transpose(key, 4)> 1/8                    // I
    enclose(transpose(key, 1))                           // pickup into 3rd of VI7
    <transpose(key, 1)> 1/8  <transpose(key, 4)> 1/8     // VI7: 3 5
    <transpose(key, 7)> 1/8  <transpose(key, 10)> 1/8    // VI7: b7 b9
    <transpose(key, 9)> 1/8  <transpose(key, 5)> 1/8     // ii: 5 b3
    enclose(transpose(key, 11))                          // pickup into 3rd of V7
    <transpose(key, 11)> 1/8 <transpose(key, 7)> 1/8     // V7: 3 1
    <transpose(key, 5)> 1/8  <transpose(key, 2)> 1/8     // V7: b7 5
}
