// ============================================================
//  grooves.wilios — drum + bass patterns (jazz-composer skill)
//
//  import "<rel>/skills/jazz-composer/lib/grooves.wilios"
//    (this file itself imports ../../../lib/lib.wilios for the presets)
//
//  Drum helpers take a bar count and run a bounded loop; call one as the
//  whole body of a drum track. Bass helpers take pitches and emit one bar
//  (or the noted number of bars). Statement position only; nothing is
//  returned. Every helper re-selects its presets, so give the kit its own
//  track(s).
//
//      swing_ride(32)                    // 32 bars of ride, one track
//      kit_swing(32)                     // hi-hat on 2 & 4, a second track
//      walk_bar(<F1>, <A1>, <C2>, <E1>)  // one walking-bass bar
// ============================================================

import "../../../lib/lib.wilios"

// --- swing_ride(bars): the "spang-a-lang" ride pattern on <F5>, on the
//     `ride` preset (a real cymbal wash). One track to itself.
let swing_ride = func(bars) {
    ride()
    let i = 0
    loop (i < bars) {
        i = i + 1
        <F5> 1/4  <F5> 1/8 <F5> 1/8  <F5> 1/4  <F5> 1/8 <F5> 1/8
    }
}

// --- kit_swing(bars): hi-hat (foot) closing on 2 and 4 — with swing_ride
//     on another track this is the swing time-keeping. (Kick 1 & 3 / snare
//     2 & 4 is a rock backbeat, not swing.)
let kit_swing = func(bars) {
    hihat_c()
    let i = 0
    loop (i < bars) {
        i = i + 1
        rest 1/4 <F5> 1/4   rest 1/4 <F5> 1/4
    }
}

// --- kit_feather(bars): "feathered" kick on all four beats. Give it its
//     own track with a very low `volume` (~15-20) — the track volume is the
//     feathering (restate `volume` around a single hit for a louder bomb).
let kit_feather = func(bars) {
    kick()
    let i = 0
    loop (i < bars) {
        i = i + 1
        <B1> 1/4 <B1> 1/4 <B1> 1/4 <B1> 1/4
    }
}

// --- kit_bossa(bars): straight (do NOT swing) — kick doubling the surdo /
//     bass rhythm: 1, &2, 3, &4 (dotted quarter + 8th, twice).
let kit_bossa = func(bars) {
    kick()
    let i = 0
    loop (i < bars) {
        i = i + 1
        <B1> 3/8 <B1> 1/8 <B1> 3/8 <B1> 1/8
    }
}

// --- bossa_clave(cycles): the 3-2 bossa clave on cross-stick, straight.
//     Bar 1: 1, &2, 4 · bar 2: 2, &3. Each cycle is 2 bars. Own track,
//     low `volume`.
let bossa_clave = func(cycles) {
    snare()
    let i = 0
    loop (i < cycles) {
        i = i + 1
        <A3> 3/8 <A3> 3/8 <A3> 1/4
        rest 1/4 <A3> 3/8 <A3> 3/8
    }
}

// --- kit_shuffle(bars): every 8th on the kit, kick/snare backbeat — with
//     `swing` 66-72 on the track this is a shuffle.
let kit_shuffle = func(bars) {
    let i = 0
    loop (i < bars) {
        i = i + 1
        kick() <B1> 1/8 hihat_c() <F5> 1/8   snare() <A3> 1/8 hihat_c() <F5> 1/8
        kick() <B1> 1/8 hihat_c() <F5> 1/8   snare() <A3> 1/8 hihat_c() <F5> 1/8
    }
}

// --- walk_bar(n1, n2, n3, n4): one bar of walking bass from four pitches
//     (root / chord tone / chord tone / approach to the next root).
//     Call bass() once on the track first.
let walk_bar = func(n1, n2, n3, n4) {
    <n1> 1/4 <n2> 1/4 <n3> 1/4 <n4> 1/4
}

// --- two_feel(root, fifth, bars): half-note root then fifth, `bars` bars.
let two_feel = func(root, fifth, bars) {
    let i = 0
    loop (i < bars) {
        i = i + 1
        <root> 1/2 <fifth> 1/2
    }
}

// --- bossa_bass2(root, fifth): two bars of the surdo bass cell, straight —
//     root on 1, fifth on &2 and 3, root on &4 (anticipating the next bar).
//     Pass `fifth` BELOW or above the root; both are idiomatic.
let bossa_bass2 = func(root, fifth) {
    <root> 3/8 <fifth> 1/8 <fifth> 3/8 <root> 1/8
    <root> 3/8 <fifth> 1/8 <fifth> 3/8 <root> 1/8
}
