// ============================================================
//  bossa.wilios — bossa nova style pack (jazz-composer skill)
//
//  import "<rel>/skills/jazz-composer/lib/bossa.wilios"
//
//  STYLE NOTES  (copy the settings into every track)
//    Tempo   110-160, felt in 2    swing 50 — STRAIGHT 8ths, do NOT swing
//    Meter   4/4
//    Presets lead brass (soft) / epiano ; comp comp_piano or epiano
//            (rootless, gentle) ; upright ; drums: kit_bossa (kick = surdo),
//            bossa_clave (cross-stick), soft hihat_c 8ths
//    Form    take it from the tune — 32-bar AABA/ABAC is common, but many
//            classics are irregular (e.g. 40 bars with a 16-bar bridge)
//    Devices bass root/5th in the surdo rhythm (1, &2, 3, &4), comp locked
//            to the 3-2 clave, changes anticipated on the &4, maj7/6-9/m7/
//            m7b5 plus altered dominants and diminished passing chords,
//            smooth syncopated melody, pan the comp slightly off-centre
//
//  Demo: examples/bossa_from_lib.wilios
// ============================================================

import "comp.wilios"
import "grooves.wilios"

// --- bossa_bass_n(root, fifth, n): `n` two-bar surdo bass cells (root on
//     1 and &4, fifth on &2 and 3), straight.
let bossa_bass_n = func(root, fifth, n) {
    let i = 0
    loop (i < n) {
        i = i + 1
        bossa_bass2(root, fifth)
    }
}

// --- bossa_comp_n(v, n): `n` two-bar clave comp figures on voicing `v`.
let bossa_comp_n = func(v, n) {
    let i = 0
    loop (i < n) {
        i = i + 1
        bossa_comp2(v)
    }
}

// --- bossa_melody_frag(key): a 4-bar legato phrase, straight 8ths.
//     `key` = the lead-register tonic (e.g. <A4>).
let bossa_melody_frag = func(key) {
    <key> 1/4 <transpose(key, 2)> 1/4 <transpose(key, 4)> 1/2
    <transpose(key, 7)> 1/4 <transpose(key, 4)> 1/4 <transpose(key, 2)> 1/2
    <transpose(key, 4)> 1/2 <transpose(key, -1)> 1/2
    <key> 1/1
}
