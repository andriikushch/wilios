// ============================================================
//  modal.wilios — modal-jazz style pack (jazz-composer skill)
//
//  import "<rel>/skills/jazz-composer/lib/modal.wilios"
//
//  STYLE NOTES  (tempo/meter on every track; swing per role —
//               see references/styles.md)
//    Tempo   60-320     swing ride 60-68, lead 54-62, or 50 for
//            straight-8th vamps      meter 4/4, 3/4 (often a 6/8 feel)
//    Presets lead brass/strings ; comp comp_piano or epiano with QUARTAL
//            voicings ; upright pedal or walking
//    Form    long sections on one mode (8-16 bars), 2-chord vamps; model:
//            32-bar AABA, A = D Dorian, B = Eb Dorian
//    Devices sustained centres, pentatonic/modal melody, wide intervallic
//            leaps, motion from register / rhythm / orchestration since
//            the harmony is static
//
//  Demo: examples/modal_from_lib.wilios
// ============================================================

import "grooves.wilios"
import "theory.wilios"

// --- so_what_vamp(bars): the two-chord "So What" answer over D Dorian —
//     the So What voicing E A D G B (three 4ths + a major 3rd), then the
//     same shape a diatonic step down, D G C F A. Placed on beat 3 and
//     the 'and' of 3. (The half step up to Eb Dorian is the bridge's key
//     change, not part of this figure.)
let so_what_vamp = func(bars) {
    let i = 0
    loop (i < bars) {
        i = i + 1
        rest 1/2   <E3, A3, D4, G4, B4> 1/8 <D3, G3, C4, F4, A4> 1/8   rest 1/4
    }
}

// --- modal_pedal(root, bars): a gentle root/5th oscillation under a
//     static centre — half notes, `bars` bars.
let modal_pedal = func(root, bars) {
    let i = 0
    loop (i < bars) {
        i = i + 1
        <root> 1/2 <transpose(root, 7)> 1/2
    }
}

// --- dorian_frag(key): a 4-bar sparse modal phrase with wide leaps,
//     picked out of the Dorian scale (theory.wilios). `key` = the tonic.
let dorian_frag = func(key) {
    let s = scale_dorian(key)                        // [1 2 b3 4 5 6 b7]
    <nth(s, 0)> 1/2 rest 1/2
    <nth(s, 4)> 1/4 <nth(s, 5)> 1/4 <nth(s, 2)> 1/2
    <nth(s, 6)> 1/1
    rest 1/1
}
