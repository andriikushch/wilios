// ============================================================
//  blues.wilios — jazz-blues style pack (jazz-composer skill)
//
//  import "<rel>/skills/jazz-composer/lib/blues.wilios"
//
//  STYLE NOTES  (tempo/meter on every track; swing per role —
//               see references/styles.md)
//    Tempo   60-300   swing  slow/shuffle 70-75 ; medium ride 64-70, lead
//            58-63 ; up-tempo ride 56-64, lead 52-58      meter 4/4
//    Presets lead brass ; comp comp_piano ; upright ; ride + hihat_c on
//            2 & 4 (snare backbeat only for a shuffle)
//    Form    12-bar:  | I7 | IV7 | I7 | v-7 I7 | IV7 | #IVdim7 | I7 | VI7 |
//                     | ii-7 | V7 | I7 VI7 | ii-7 V7 |
//    Devices blue notes (b3, b5, b7), riff-and-answer head, IV7 -> #IVdim7
//            -> I7/5, tritone-sub bII7 in the turnaround, two-feel on the
//            head and walking 4 for solos
//
//  Full model: examples/blues_f.wilios . Demo: examples/blues_from_lib.wilios
// ============================================================

import "licks.wilios"
import "grooves.wilios"

// --- blues_walk12(key): a full 12-bar walking-bass chorus. `key` = the
//     I7 root pitch in the bass register (e.g. <F1>). Each bar is a
//     walk_bar whose four notes outline that bar's chord and approach the
//     next root.
//     In F (key = <F1>):
//     | F A C B | Bb Ab G Gb | F G A B | C Bb A B | Bb D F C | B Ab F Gb |
//     | F A C C# | D C A Ab | G Bb D Db | C E G Gb | F A D Ab | G Bb C Gb |
//     Every bar ends a half step from the next bar's first note.
let blues_walk12 = func(key) {
    walk_bar(key, transpose(key, 4), transpose(key, 7), transpose(key, 6))                    // I7 -> IV7
    walk_bar(transpose(key, 5), transpose(key, 3), transpose(key, 2), transpose(key, 1))      // IV7 -> I7
    walk_bar(key, transpose(key, 2), transpose(key, 4), transpose(key, 6))                    // I7 -> v-7
    walk_bar(transpose(key, 7), transpose(key, 5), transpose(key, 4), transpose(key, 6))      // v-7 I7 -> IV7
    walk_bar(transpose(key, 5), transpose(key, 9), transpose(key, 12), transpose(key, 7))     // IV7 -> #IVdim7
    walk_bar(transpose(key, 6), transpose(key, 3), key, transpose(key, 1))                    // #IVdim7 -> I7
    walk_bar(key, transpose(key, 4), transpose(key, 7), transpose(key, 8))                    // I7 -> VI7
    walk_bar(transpose(key, 9), transpose(key, 7), transpose(key, 4), transpose(key, 3))      // VI7 -> ii-7
    walk_bar(transpose(key, 2), transpose(key, 5), transpose(key, 9), transpose(key, 8))      // ii-7 -> V7
    walk_bar(transpose(key, 7), transpose(key, 11), transpose(key, 2), transpose(key, 1))     // V7 -> I7
    walk_bar(key, transpose(key, 4), transpose(key, 9), transpose(key, 3))                    // I7 VI7 -> ii-7
    walk_bar(transpose(key, 2), transpose(key, 5), transpose(key, 7), transpose(key, 1))      // ii-7 V7 -> I7
}

// --- blues_riff2(key): the 2-bar call — leaning on b3 / 3 / b5 / b7.
let blues_riff2 = func(key) {
    <key> 1/8 <transpose(key, 3)> 1/8 <transpose(key, 4)> 1/8 <transpose(key, 7)> 1/8   <transpose(key, 6)> 1/4 rest 1/4
    rest 1/2   <transpose(key, 10)> 1/8 <transpose(key, 7)> 1/8 <transpose(key, 3)> 1/8 <key> 1/8
}

// --- blues_riff4(key): a 4-bar riff-and-answer phrase over one chord:
//     the 2-bar call, a 1-bar answer, a bar of space.
//     `key` = the lead-register root (e.g. <F4>).
let blues_riff4 = func(key) {
    blues_riff2(key)
    <key> 1/4 <transpose(key, 3)> 1/8 <transpose(key, 4)> 1/8   <transpose(key, 7)> 1/4 rest 1/4
    rest 1/1
}

// --- blues_riff_head(key): the 12-bar head, following the changes —
//     riff on I (bars 1-4), the call up a fourth over IV7 (bars 5-6),
//     the call home over I7 (bars 7-8), riff on I over the ii-V
//     turnaround (bars 9-12).
let blues_riff_head = func(key) {
    blues_riff4(key)
    blues_riff2(transpose(key, 5))
    blues_riff2(key)
    blues_riff4(key)
}
