// lib.wilios — FM synthesis presets
//
// Usage: import "lib/lib.wilios" (adjust the path relative to your source
// file — "../lib/lib.wilios" from examples/) then call a patch function
// inside a track to configure FM synthesis for subsequent notes.
//
// Each function sets the track's fm block, waveform, and (where useful) a
// low-pass filter or vibrato. Call it once per track before playing notes.
//
// Voiced for the current engine: exponential ADSR, band-limited saw/square,
// per-voice `cutoff`/`resonance` low-pass and `vibrato` (see doc/synthesis.md).
//
// 14 presets:
//   Tonal : epiano  brass  trumpet  bass  upright  marimba  strings  comp_piano
//   Drums : kick  snare  hihat_c  hihat_o  ride  brushes

// E.PIANO 1 — Algorithm 5
// Two independent 2-op pairs summed as carriers.
// High-ratio (14x) modulators create the characteristic bell "ting" attack.
// Purely percussive: no sustain. A gentle low-pass rounds off the tine fizz.
let epiano = func() {
    wave sine
    cutoff 9000
    resonance 0.1
    fm {
        algorithm [2->1, 4->3]
        op 1 { ratio 1.0   level 0.5  attack 8   decay 1300  sustain 0   release 320 }
        op 2 { ratio 14.0  level 0.7  attack 0   decay 420   sustain 0   release 120 }
        op 3 { ratio 1.0   level 0.25 attack 8   decay 1800  sustain 0   release 380 }
        op 4 { ratio 14.0  level 0.4  attack 0   decay 300   sustain 0   release 90  }
    }
}

// BRASS 1 — brass stab
// Same-ratio modulator at high depth decays quickly, creating the
// bright "blat" attack that settles into a warm sustained tone.
// A soft low-pass keeps the blat from getting edgy. No vibrato — this is a stab.
let brass = func() {
    wave sine
    cutoff 4500
    fm {
        algorithm [2->1]
        op 1 { ratio 1.0  level 1.0  attack 18  decay 0    sustain 100  release 180 }
        op 2 { ratio 1.0  level 2.5  attack 8   decay 220  sustain 25   release 90  }
    }
}

// TRUMPET — sustained FM brass with vibrato
// A same-ratio modulator held through the sustain gives the buzzy brass body;
// a low-pass tames FM fizz and a gentle vibrato adds air on held notes.
// Slower, tongued onset than the BRASS stab. Play <A3>-<A5>.
let trumpet = func() {
    wave sine
    cutoff 3400
    resonance 0.1
    vibrato 22 5.5
    fm {
        algorithm [2->1]
        op 1 { ratio 1.0  level 0.85  attack 42  decay 110  sustain 82  release 130 }
        op 2 { ratio 1.0  level 1.7   attack 34  decay 200  sustain 48  release 110 }
    }
}

// BASS 1 — deep FM bass
// Sub-octave modulator (ratio 0.5) at high depth produces a thick,
// punchy transient that quickly falls away for a clean low-end body.
let bass = func() {
    wave sine
    cutoff 3000
    fm {
        algorithm [2->1]
        op 1 { ratio 1.0  level 1.0  attack 4   decay 450  sustain 50  release 200 }
        op 2 { ratio 0.5  level 2.0  attack 0   decay 220  sustain 0   release 70  }
    }
}

// UPRIGHT — fingered acoustic bass
// Same-ratio modulator at modest depth gives a soft, woody thump that
// settles onto a warm fundamental with a short sustain — rounder and less
// punchy than BASS. Play low (e.g. <E1>-<G2>).
let upright = func() {
    wave sine
    cutoff 2400
    fm {
        algorithm [2->1]
        op 1 { ratio 1.0  level 1.0  attack 6  decay 380  sustain 35  release 150 }
        op 2 { ratio 1.0  level 1.2  attack 0  decay 150  sustain 0   release 50  }
    }
}

// MARIMBA — bell/mallet timbre
// Two inharmonic modulators (3.5x and 5x) feeding one carrier.
// Inharmonic ratios give a metallic, resonant bell quality.
// Fast decay, no sustain.
let marimba = func() {
    wave sine
    cutoff 8000
    fm {
        algorithm [2->1, 3->1]
        op 1 { ratio 1.0  level 1.0  attack 4   decay 520  sustain 0  release 260 }
        op 2 { ratio 3.5  level 1.8  attack 0   decay 260  sustain 0  release 90  }
        op 3 { ratio 5.0  level 0.6  attack 0   decay 150  sustain 0  release 70  }
    }
}

// STRINGS — lush slow pad
// Two 2-op pairs: fundamental and octave carriers, both with slow
// attacks for a smooth swell. Gentle modulation adds harmonic warmth;
// a slow vibrato and a soft low-pass give it movement without brightness.
let strings = func() {
    wave sine
    cutoff 4500
    vibrato 7 5
    fm {
        algorithm [2->1, 4->3]
        op 1 { ratio 1.0  level 0.5  attack 450  decay 0  sustain 100  release 800  }
        op 2 { ratio 1.0  level 0.3  attack 300  decay 0  sustain 80   release 600  }
        op 3 { ratio 2.0  level 0.25 attack 550  decay 0  sustain 90   release 1000 }
        op 4 { ratio 3.0  level 0.2  attack 400  decay 0  sustain 70   release 700  }
    }
}

// COMP_PIANO — sustaining comping keyboard
// Two carrier layers (op 1, op 3) both hold a real sustain, so voiced
// chords ring under a melody instead of decaying away like EPIANO. Mild
// inharmonic modulators add a little tine colour without the bell "ting".
let comp_piano = func() {
    wave sine
    cutoff 7000
    resonance 0.08
    fm {
        algorithm [2->1, 4->3]
        op 1 { ratio 1.0  level 0.6  attack 5  decay 340  sustain 55  release 460 }
        op 2 { ratio 3.0  level 0.5  attack 3  decay 240  sustain 25  release 220 }
        op 3 { ratio 1.0  level 0.35 attack 6  decay 480  sustain 45  release 620 }
        op 4 { ratio 7.0  level 0.3  attack 2  decay 160  sustain 10  release 130 }
    }
}

// KICK — bass drum
// Fast-decaying high-depth sub-octave modulator creates the characteristic
// pitch-drop thud. Best triggered at a low note (e.g. <B1>).
let kick = func() {
    wave sine
    fm {
        algorithm [2->1]
        op 1 { ratio 1.0   level 1.0  attack 4  decay 260  sustain 0  release 45 }
        op 2 { ratio 0.25  level 9.0  attack 0  decay 45   sustain 0  release 18 }
    }
}

// SNARE — snare drum
// Two inharmonic modulators (11x and 17x) on a band-limited square carrier
// produce a bright, noise-like crack. Best triggered at a mid note (e.g. <A3>).
let snare = func() {
    wave square
    cutoff 12000
    fm {
        algorithm [2->1, 3->1]
        op 1 { ratio 1.0   level 1.0  attack 0  decay 140  sustain 0  release 35 }
        op 2 { ratio 11.0  level 4.5  attack 0  decay 70   sustain 0  release 22 }
        op 3 { ratio 17.0  level 2.8  attack 0  decay 55   sustain 0  release 18 }
    }
}

// HIHAT_C — closed hi-hat
// Two high-ratio inharmonic modulators give a short metallic click.
// Best triggered at a high note (e.g. <F5>).
let hihat_c = func() {
    wave sine
    fm {
        algorithm [2->1, 3->1]
        op 1 { ratio 1.0   level 1.0  attack 0  decay 45   sustain 0  release 12 }
        op 2 { ratio 13.0  level 5.0  attack 0  decay 24   sustain 0  release 8  }
        op 3 { ratio 17.5  level 4.0  attack 0  decay 20   sustain 0  release 8  }
    }
}

// HIHAT_O — open hi-hat
// Same topology as hihat_c but longer decays for the sustained "tsss".
// Best triggered at a high note (e.g. <F5>).
let hihat_o = func() {
    wave sine
    fm {
        algorithm [2->1, 3->1]
        op 1 { ratio 1.0   level 1.0  attack 0  decay 300  sustain 0  release 150 }
        op 2 { ratio 13.0  level 5.0  attack 0  decay 140  sustain 0  release 65  }
        op 3 { ratio 17.5  level 4.0  attack 0  decay 115  sustain 0  release 50  }
    }
}

// RIDE — ride cymbal
// Lower, more musical inharmonic partials (4.1x, 6.7x) than the hi-hats.
// Decays and levels trimmed so a steady ride pattern shimmers instead of
// piling up into a wash. Best triggered high (e.g. <F5>); keep volume low.
let ride = func() {
    wave sine
    fm {
        algorithm [2->1, 3->1]
        op 1 { ratio 1.0  level 1.0  attack 0  decay 1100  sustain 0  release 700 }
        op 2 { ratio 4.1  level 2.4  attack 0  decay 850   sustain 0  release 520 }
        op 3 { ratio 6.7  level 1.8  attack 0  decay 950   sustain 0  release 600 }
    }
}

// BRUSHES — snare brush swish
// Soft attack and mid-band inharmonic modulators (7.5x, 12.3x) give a
// breathy, sustained swish rather than SNARE's hard crack. Play around
// <A3>-<D4>.
let brushes = func() {
    wave sine
    cutoff 9000
    fm {
        algorithm [2->1, 3->1]
        op 1 { ratio 1.0   level 1.0  attack 24  decay 250  sustain 0  release 100 }
        op 2 { ratio 7.5   level 3.5  attack 16  decay 200  sustain 0  release 75  }
        op 3 { ratio 12.3  level 2.5  attack 16  decay 160  sustain 0  release 65  }
    }
}
